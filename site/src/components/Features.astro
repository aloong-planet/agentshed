---
// The scroll-linked features section (landing-page::REQ-004): four text steps on the left, one screenshot
// frame on the right showing the step nearest its middle. Below 760px the frame goes and every step carries
// its own screenshot. As served, the first step is the current one; the script picks the nearest once it runs.
import { ui, type Locale } from '../i18n/ui'
import { FEATURE_SHOTS, FEATURE_SIZE, shotSrc } from '../shots'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = ui[locale]
const steps = t.features.steps.map((step, i) => ({ ...step, i, src: shotSrc(FEATURE_SHOTS[i]!, locale) }))
---

<section class="section soft" id="features">
  <div class="wrap">
    <h2 class="sec-title">{t.features.title}</h2>
    <p class="sec-sub">{t.features.subtitle}</p>
    <div class="fs">
      <div class="fs-list">
        {
          steps.map((s) => (
            <div class="fs-step">
              <button type="button" class:list={['fs-item', { on: s.i === 0 }]} data-i={s.i}>
                <span class="fs-h">{s.title}</span>
                <span class="fs-p">{s.body}</span>
              </button>
              <div class="shot m-shot">
                <div class="chrome"><i></i><i></i><i></i></div>
                <img src={s.src} width={FEATURE_SIZE.width} height={FEATURE_SIZE.height} alt={s.alt} loading="lazy" />
              </div>
            </div>
          ))
        }
      </div>
      <div class="shot fs-panel">
        <div class="chrome"><i></i><i></i><i></i></div>
        <div class="fs-stack">
          {
            steps.map((s) => (
              <img class:list={{ on: s.i === 0 }} src={s.src} width={FEATURE_SIZE.width} height={FEATURE_SIZE.height} alt={s.alt} />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
