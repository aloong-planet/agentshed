{
  "name": "agentshed",
  "version": "0.1.0",
  "description": "你的 coding agents 工具棚:Claude Code 与 Codex 的项目全景与 skills 装卸",
  "license": "MIT",
  "main": "./out/main/index.js",
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never -c.mac.notarize=false",
    "e2e": "electron-vite build && playwright test",
    "verify": "pnpm typecheck && pnpm test && pnpm check:ui && pnpm e2e && pnpm smoke",
    "smoke": "bash scripts/smoke.sh",
    "check:ui": "node scripts/check-shared-ui.mjs --cross"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.0",
    "electron-vite": "^2.3.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "marked": "^15.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
