{
  "name": "agentshed",
  "version": "0.1.0",
  "description": "Your coding agents shed: an overview of Claude Code, Codex and Grok projects, with skill install and uninstall",
  "license": "MIT",
  "main": "./out/main/index.js",
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "prepare": "husky",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never -c.mac.notarize=false",
    "e2e": "electron-vite build && playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:ui && pnpm check:lang && pnpm check:i18n && pnpm check:nul && pnpm e2e && pnpm smoke",
    "smoke": "bash scripts/smoke.sh",
    "check:ui": "node scripts/check-shared-ui.mjs --cross",
    "check:lang": "node scripts/check-lang.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:nul": "node scripts/check-raw-nul.mjs",
    "bench:scan": "node scripts/bench-scan.mjs",
    "restore:archive": "node scripts/restore-archive.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.21.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "dompurify": "^3.4.12",
    "marked": "^15.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smol-toml": "^1.7.1"
  }
}
