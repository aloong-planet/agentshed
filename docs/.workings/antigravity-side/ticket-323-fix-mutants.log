# #323 — mutation runs for the post-implementation check's fixes (F1–F7), 2026-10-29
# Worktree /Users/loong_zhou/CascadeProjects/agentshed-wt-323 over fc5d0b1 with the fix's uncommitted tests.
# Each run: node mutate.mjs <file> <search> <replace> -- <command>; the script replaces the single occurrence
# (it refuses a search text occurring other than once), runs the command, and restores the original bytes in
# `finally`, checking them byte for byte. `mutant command exit` is the test command's exit code (1 = red).
# m15 rebuilt the app inside the mutant; the targeted verification rebuilds from the restored source.

## mutate.mjs
// Usage: node mutate.mjs <file> <search-file> <replace-file> -- <command...>
// Replaces the single occurrence of the search text with the replacement, runs the command, and restores the file's
// original bytes in `finally`, then checks them byte for byte. The search text must occur exactly once.
import { readFileSync, writeFileSync } from 'node:fs'
import { spawnSync } from 'node:child_process'

const [file, searchFile, replaceFile, sep, ...cmd] = process.argv.slice(2)
if (sep !== '--' || cmd.length === 0) throw new Error('usage: mutate.mjs <file> <search-file> <replace-file> -- <command...>')
const original = readFileSync(file)
const text = original.toString('utf8')
const search = readFileSync(searchFile, 'utf8')
const replace = readFileSync(replaceFile, 'utf8')
const count = text.split(search).length - 1
if (count !== 1) throw new Error(`search text occurs ${count} times in ${file}`)
let status = null
try {
  writeFileSync(file, text.replace(search, () => replace))
  const r = spawnSync(cmd[0], cmd.slice(1), { stdio: 'inherit', shell: false })
  status = r.status
} finally {
  writeFileSync(file, original)
  const back = readFileSync(file)
  if (!back.equals(original)) throw new Error(`RESTORE FAILED for ${file}`)
  console.log(`restored ${file} byte-exact`)
}
console.log(`mutant command exit=${status}`)


