## The script (mutate-r1.mjs)
```js
// Reversible mutations for #325's round-1 cases: each applied alone, the components suite run, the file restored
// byte for byte in finally (never via git).
import { readFileSync, writeFileSync } from 'node:fs'
import { spawnSync } from 'node:child_process'
const W = '/Users/loong_zhou/CascadeProjects/agentshed-wt-325'
const muts = [
  ['M1 enabled only when absent or true', 'src/main/providers/plugins.ts', "enabled: rec['enabled'] !== false,", "enabled: rec['enabled'] === undefined || rec['enabled'] === true,", ['an enabled value other than true or false']],
  ['M2 record looked up by the manifest name', 'src/main/providers/plugins.ts', "const record = records[d.name]", "const record = records[String(readJson(join(root, 'plugin.json'))?.['name'] ?? d.name)]", ['a plugin is its directory']],
  ['M3 agent fallback name not the file', 'src/main/providers/plugins.ts', "agents.push(agyDefinitionName(readTextCapped(file), basename(d.name, '.md')))", "agents.push(agyDefinitionName(readTextCapped(file), 'unnamed'))", ['a bundled agent without a front matter name']],
  ['M4 later definition wins in one directory', 'src/main/providers/subagents.ts', "const name = fmValue(fm, 'name') ?? fallback\n    if (out.has(name)) continue", "const name = fmValue(fm, 'name') ?? fallback", ['two definitions in one directory giving one name']],
  ['M5 first existing entry, SKILL.md or not', 'src/main/providers/skill-package.ts', "return entries.find((e) => existsSync(join(e, 'SKILL.md'))) ?? entries.find((e) => existsSync(e)) ?? null", "return entries.find((e) => existsSync(e)) ?? null", ['a higher directory holding the name without a SKILL.md']],
  ['M6 Claude plugin server names the full plugin id', 'src/main/providers/global.ts', "out.push({ name, side: 'claude', source: 'plugin', disabled: false, plugin: plugin.name.split('@')[0] })", "out.push({ name, side: 'claude', source: 'plugin', disabled: false, plugin: plugin.name })", ['a Claude plugin and an Antigravity plugin bundling one skill name']]
]
for (const [label, rel, from, to, expectRed] of muts) {
  const file = `${W}/${rel}`
  const orig = readFileSync(file)
  const text = orig.toString('utf8')
  const n = text.split(from).length - 1
  if (n !== 1) { console.log(`${label}: SKIPPED, anchor found ${n} times`); continue }
  try {
    writeFileSync(file, text.replace(from, () => to))
    const reached = readFileSync(file, 'utf8').includes(to)
    const r = spawnSync('pnpm', ['exec', 'vitest', 'run', 'src/main/providers/antigravity-components.test.ts'], { cwd: W, encoding: 'utf8' })
    const out = r.stdout + r.stderr
    const failed = [...out.matchAll(/×\s+(.+?)\s+\d+ms/g)].map((m) => m[1])
    const hits = expectRed.map((t) => failed.some((f) => f.includes(t)))
    console.log(`${label}: mutation present=${reached} exit=${r.status} failed=${failed.length} expected-red-hit=${hits.join(',')}`)
    for (const f of failed) console.log(`   × ${f}`)
  } finally {
    writeFileSync(file, orig)
  }
  console.log(`   restored byte-identical=${Buffer.compare(readFileSync(file), orig) === 0}`)
}
```
