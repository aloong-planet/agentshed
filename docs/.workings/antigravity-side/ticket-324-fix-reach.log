## The e2e byte figure: script
$ node reach3.mjs
import { readFileSync, writeFileSync } from 'node:fs'
import { spawnSync } from 'node:child_process'
const root = '/Users/loong_zhou/CascadeProjects/agentshed-wt-324'
const file = `${root}/src/main/index.ts`
const from = '    bytes: statSync(file).size,'
const to = '    bytes: statSync(source).size,'
const orig = readFileSync(file)
const text = orig.toString('utf8')
const n = text.split(from).length - 1
if (n !== 1) { console.log(`target found ${n} times — not run`); process.exit(2) }
try {
  writeFileSync(file, text.replace(from, () => to))
  const r = spawnSync('pnpm', ['e2e', 'e2e/app.spec.ts', '-g', 'Antigravity sessions: AG rows'], { cwd: root, encoding: 'utf8' })
  const out = r.stdout + r.stderr
  console.log(`T42 transcript size shown: exit=${r.status}`)
  console.log(out.split('\n').filter((l) => /passed|failed|Expected|Received|toContainText|Error:/.test(l)).slice(0, 12).join('\n'))
} finally {
  writeFileSync(file, orig)
}
console.log(`restored byte for byte: ${Buffer.compare(readFileSync(file), orig) === 0}`)

