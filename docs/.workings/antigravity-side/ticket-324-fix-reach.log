# Reach checks for the post-implementation check's fix (#324), 2026-10-29
# Not mutation testing (capabilities.toml declares mutation-testing disabled): each alteration of the product code,
# applied alone and restored byte for byte, confirms that a new case reaches the line its 'goes red when' answer names.
# Run on the fix's working tree over 05faa8a; the e2e check rebuilt the app first (pnpm e2e runs electron-vite build).

## Unit cases: script
$ node reach-final.mjs
// Reach checks for the fix's new cases: each alteration applied alone, the named case run, the file restored byte for
// byte in finally. Not mutation testing (the project's capability declares it disabled); it confirms each case reaches
// the line its "goes red when" answer names.
import { readFileSync, writeFileSync } from 'node:fs'
import { spawnSync } from 'node:child_process'
const root = '/Users/loong_zhou/CascadeProjects/agentshed-wt-324'
const P = (f) => `${root}/${f}`
const checks = [
  ['R1 T35: the subagent detection lost', 'src/main/providers/antigravity.ts', "conversation: { id: [...self][0], subagent: isSubagent(m), at, forkOf }", "conversation: { id: [...self][0], subagent: false, at, forkOf }", 'src/main/providers/antigravity.test.ts', 'was asked something'],
  ['R2 T36: the subagent detection lost', 'src/main/providers/antigravity.ts', "conversation: { id: [...self][0], subagent: isSubagent(m), at, forkOf }", "conversation: { id: [...self][0], subagent: false, at, forkOf }", 'src/main/providers/question-corpus.test.ts', 'Antigravity conversation joins'],
  ['R3 T35: the listed guard dropped alone (the transcript guard kept)', 'src/main/providers/token-stats.ts', 'listed: !c.subagent && questions.length > 0,', 'listed: questions.length > 0,', 'src/main/providers/antigravity.test.ts', 'was asked something'],
  ['R4 T35: the transcript guard dropped alone (the listed guard kept)', 'src/main/providers/token-stats.ts', "  if (!c.subagent) {\n    const idx = makeAntigravityQuestionIndexer()", "  if (true) {\n    const idx = makeAntigravityQuestionIndexer()", 'src/main/providers/antigravity.test.ts', 'was asked something'],
  ['R5 T37: the last message only', 'src/main/providers/turn-content.ts', 'sub.result = sub.result === null ? body : `${sub.result}\\n\\n${body}`', 'sub.result = body', 'src/main/providers/turn-content.test.ts', 'two messages'],
  ['R6 T38: a failed read at a build drops the titles', 'src/main/providers/token-stats.ts', 'readAgySummaryTitles(roots.antigravityHome, this.agyTmpParent) ?? this.agyTitles ?? new Map()', 'readAgySummaryTitles(roots.antigravityHome, this.agyTmpParent) ?? new Map()', 'src/main/providers/antigravity.test.ts', 'keeps the titles last read'],
  ['R7 T38: the build does not pass the copy directory', 'src/main/providers/token-stats.ts', 'readAgySummaryTitles(roots.antigravityHome, this.agyTmpParent) ?? this.agyTitles ?? new Map()', 'readAgySummaryTitles(roots.antigravityHome) ?? this.agyTitles ?? new Map()', 'src/main/providers/antigravity.test.ts', 'keeps the titles last read'],
  ['R8 T38: the page\'s first read does not pass the copy directory', 'src/main/providers/token-stats.ts', 'this.agyTitles ??= readAgySummaryTitles(roots.antigravityHome, this.agyTmpParent) ?? new Map()', 'this.agyTitles ??= readAgySummaryTitles(roots.antigravityHome) ?? new Map()', 'src/main/providers/antigravity.test.ts', 'keeps the titles last read'],
  ['R9 T41 (b): a line without an index can be undone', 'src/main/providers/question-index.ts', 'kept[i] = s === null || s < laterMin', 'kept[i] = (s as number) < laterMin', 'src/main/providers/question-index.test.ts', 'without a step index'],
  ['R10 T41 (a): a line without an index is a redo', 'src/main/providers/question-index.ts', 'if (s !== null && s < laterMin) laterMin = s', 'if ((s as number) < laterMin) laterMin = s as number', 'src/main/providers/question-index.test.ts', 'without a step index'],
  ['R11 T43: the shape guard after the field read', 'src/main/providers/token-stats.ts', "if (isWellFormedAgg(v?.agg) && v.agg.kind === 'antigravity'", "if ((v as { agg: FileAgg }).agg.kind === 'antigravity' && isWellFormedAgg(v?.agg)", 'src/main/providers/antigravity.test.ts', 'corrupt cache entry ahead']
]
for (const [name, file, from, to, test, grep] of checks) {
  const orig = readFileSync(P(file))
  const text = orig.toString('utf8')
  const n = text.split(from).length - 1
  if (n !== 1) { console.log(`${name}: target found ${n} times — not run`); continue }
  try {
    writeFileSync(P(file), text.replace(from, () => to))
    const r = spawnSync('pnpm', ['exec', 'vitest', 'run', test, '-t', grep], { cwd: root, encoding: 'utf8' })
    const summary = (r.stdout + r.stderr).split('\n').filter((l) => /Tests\s+\d|AssertionError|TypeError|Expected|Received/.test(l)).slice(0, 6).join(' | ')
    console.log(`${name}: exit=${r.status} ${summary}`)
  } finally {
    writeFileSync(P(file), orig)
  }
  const back = readFileSync(P(file))
  console.log(`  restored byte for byte: ${Buffer.compare(back, orig) === 0}`)
}

